# ==================================================
# LinkedIn Clone - Root Environment Variables
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration (PostgreSQL)
# Embedded PostgreSQL will start on port 5433 with this connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/synapse_db?schema=public"

# Alternatively, for external or cloud PostgreSQL (Neon, Supabase):
# DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/synapse_db?sslmode=require"

# JWT Authentication
JWT_SECRET="linkedin_clone_super_secure_jwt_secret_token_dev_2026"
JWT_EXPIRES_IN="7d"

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
